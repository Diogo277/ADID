{
  "manifest_version": 3,
  "name": "ADID - Acessibilidade (Extensão)",
  "version": "1.1",
  "description": "Adapta cores para acessibilidade: Deuteranopia, Protanopia e Tritanopia.",
  "icons": {
    "16":  "images/logotipo.png",
    "48":  "images/logotipo.png",
    "128": "images/logotipo.png"
  },
  "action": {
    "default_title": "ADID Acessibilidade",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/logotipo.png",
      "48": "images/logotipo.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
